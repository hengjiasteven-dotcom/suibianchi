# 随便吃 · 服务端环境变量模板
# 用法：复制成 server/.env 后填写真实值（这个文件不要提交到仓库）

# ---------- 安全（必改）----------
# 签发登录令牌用的密钥，换成一串随机字符串；泄露 = 别人能伪造登录态
SHIJI_JWT_SECRET=please-change-me-to-a-long-random-string
# 生产必须关掉开发模式！开着的话接口会直接把验证码返回，任何人都能登录任意手机号
SHIJI_SMS_DEV_MODE=0

# ---------- AI（识别 / 估算 / 对话 / 分类）----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 每天每用户 / 全站的 AI 调用上限，防止被人刷额度
SHIJI_AI_DAILY_PER_USER=100
SHIJI_AI_DAILY_TOTAL=2000

# ---------- 图片存储（七牛云）----------
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=shiji-meals
QINIU_DOMAIN=https://eating.xiaodaidai.site

# ---------- 附近店铺（百度地图开放平台）----------
SHIJI_MAP_PROVIDER=baidu
BAIDU_MAP_AK=

# ---------- 数据存放 ----------
# 建议指向单独目录，方便备份和迁移
SHIJI_DB_PATH=/www/wwwroot/shiji-api/server/data/shiji.db
# 对话会话在进程内存里，先说 10 分钟；以后可以换成 Redis
SHIJI_CHAT_TTL=600

# ---------- 短信服务商（待接）----------
# 接好之后把 SHIJI_SMS_DEV_MODE 设为 0
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

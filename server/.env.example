# 复制为 .env 后填写；这个文件不要提交到代码仓库
# 必填：DeepSeek 密钥（只存在服务器上，App 永远不接触）
DEEPSEEK_API_KEY=sk-替换成你的密钥

# 可选：模型与地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 生产环境务必改成随机串，越长越好
SHIJI_JWT_SECRET=请替换成至少32位随机字符串

# 短信：生产改为 0，并接入短信服务商
SHIJI_SMS_DEV_MODE=0

# 七牛云（图片存储）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=shiji-meals
QINIU_DOMAIN=
# 空间绑定的访问域名（客户端直传时的上传入口）
QINIU_UPLOAD_HOST=https://up.qiniup.com
# 空间是私有读时置 1：接口会返回签名 URL，有效期见下一项（秒）
QINIU_PRIVATE=0
QINIU_URL_TTL=21600

# 地图（附近商家检索）
SHIJI_MAP_PROVIDER=baidu
BAIDU_MAP_AK=

# AI 配额：防止接口被人白嫖
SHIJI_AI_DAILY_PER_USER=100
SHIJI_AI_DAILY_TOTAL=2000

# 数据与索引路径（Docker 里用默认值即可）
SHIJI_DATA_DIR=/data
SHIJI_HEAT_INDEX=/app/heat_index.jsonl
